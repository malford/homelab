{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "*"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    },
    {
      // Argo auto-syncs these with prune+selfHeal, so they land one at a time.
      // Managers are scoped so in-repo go.mod deps stay in the grouped PR.
      "matchFileNames": [
        "system/**",
        "platform/**"
      ],
      "matchManagers": [
        "helmv3",
        "helm-values"
      ],
      "groupName": null
    },
    {
      // Rook operator and cluster must move in lockstep, and both live in the
      // same Chart.yaml, so split PRs would skew them and then conflict.
      // Rook forbids skipping minors, so the ceiling is raised one minor per
      // hop by hand. On v1.20.9; <1.21.0 now allows nothing, which is correct —
      // raise it deliberately when the 1.21 hop is planned.
      "matchPackageNames": [
        "rook-ceph",
        "rook-ceph-cluster"
      ],
      "allowedVersions": "<1.21.0",
      "groupName": "rook-ceph"
    },
    {
      // 1.20 dropped the in-rook CSI driver, so this chart supplies the Driver
      // CRs the vendored ceph-csi-operator reconciles. It must track the
      // operator version rook vendors (v1.0.4), so only patches float here;
      // a minor needs a rook hop to match it.
      "matchPackageNames": [
        "ceph-csi-drivers"
      ],
      "allowedVersions": "<1.1.0",
      "groupName": "rook-ceph"
    },
    {
      // Kanidm forbids skipping minors - a server reads at most one domain level
      // back, so 1.4 -> 1.6 cannot migrate. On 1.4.6 (DL8); raise the ceiling one
      // minor per hop by hand. See docs/how-to-guides/kanidm-upgrade.md.
      "matchPackageNames": [
        "docker.io/kanidm/server"
      ],
      "allowedVersions": "<1.6.0",
      "groupName": null
    },
    {
      // v2 -> v3 is a module path change, not a version bump. See PR #49.
      "matchPackageNames": [
        "gopkg.in/yaml.v2"
      ],
      "enabled": false
    },
    {
      // docker versioning reads everything after the first hyphen as a platform
      // marker it must never change, and the trailing git hash differs every
      // release - so no candidate ever qualifies and the tag is frozen. Match the
      // hash without capturing it (regex groups must be numeric); the $ anchor
      // keeps the -amd64/-arm64/-armhf variants out.
      "matchPackageNames": [
        "docker.io/plexinc/pms-docker"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-[0-9a-f]+$"
    },
    {
      // Same freeze from linuxserver's -lsNN build counter. Capturing it as
      // revision keeps the immutable pin while letting rebuilds through.
      "matchPackageNames": [
        "lscr.io/linuxserver/lidarr"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-ls(?<revision>\\d+)$"
    },
    {
      // Ansible defaults only take effect when the play is run by hand, so these
      // must not ride along in the auto-deployed grouped PR.
      "matchManagers": [
        "custom.regex"
      ],
      "groupName": null
    }
  ],
  "customManagers": [
    {
      // k3s and cilium versions live in ansible defaults, which no manager reads,
      // so both were invisible to renovate. Argo never applies these files - a PR
      // here is notification only.
      "customType": "regex",
      "managerFilePatterns": [
        "/^metal/roles/.+/defaults/main\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?\\s+\\w+_version: \"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    }
  ]
}
