{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "id": 0,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Network path",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "NAS → Apple TV traffic",
      "description": "Switch port counters: NAS eth0 (switch-16p-office port 2) vs Apple TV (gw-dmse-office port 1).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "appletv",
          "editorMode": "code",
          "expr": "sum(rate(unpoller_device_port_transmit_bytes_total{name=\"gw-dmse-office\", port_num=\"1\"}[$__rate_interval])) * 8",
          "legendFormat": "appletv",
          "range": true
        },
        {
          "refId": "nas01",
          "editorMode": "code",
          "expr": "sum(rate(unpoller_device_port_receive_bytes_total{name=\"switch-16p-office\", port_num=\"2\"}[$__rate_interval])) * 8",
          "legendFormat": "nas01",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "NFS media read (k3s node)",
      "description": "node_exporter mountstats for the Plex media PVC export.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(rate(node_mountstats_nfs_read_bytes_total{export=\"192.168.3.20:/volume1/media\"}[$__rate_interval])) * 8",
          "legendFormat": "nfs read",
          "range": true
        }
      ]
    },
    {
      "type": "row",
      "title": "Plex pod",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 },
      "id": 4,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Plex CPU (cores)",
      "description": "Spikes during playback usually mean transcoding rather than direct play.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 11 },
      "id": 5,
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "axisLabel": "cores" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": ["max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"media\", container=\"plex\"}[$__rate_interval]))",
          "legendFormat": "cpu",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Plex memory",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 11 },
      "id": 6,
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": ["max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(container_memory_working_set_bytes{namespace=\"media\", container=\"plex\"})",
          "legendFormat": "working set",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Plex stream out",
      "description": "Pod network transmit - what Plex sends to clients. Lower than NFS read usually means transcoding.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 11 },
      "id": 7,
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": ["max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(rate(container_network_transmit_bytes_total{namespace=\"media\", pod=~\"plex.*\"}[$__rate_interval])) * 8",
          "legendFormat": "plex out",
          "range": true
        }
      ]
    },
    {
      "type": "row",
      "title": "Synology NAS",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 },
      "id": 8,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "NAS CPU",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 20 },
      "id": 9,
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": ["max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "ssCpuUser{job=\"snmp\"} + ssCpuSystem{job=\"snmp\"}",
          "legendFormat": "cpu",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "NAS memory used",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 20 },
      "id": 10,
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": ["max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "100 * (memTotalReal{job=\"snmp\"} - memAvailReal{job=\"snmp\"} - memBuffer{job=\"snmp\"} - memCached{job=\"snmp\"}) / memTotalReal{job=\"snmp\"}",
          "legendFormat": "memory",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "NAS disk read",
      "description": "Sum of reads across all five SATA disks - roughly what the volume is serving.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 20 },
      "id": 11,
      "fieldConfig": {
        "defaults": {
          "unit": "binBps",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": ["max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(rate(storageIONReadX{job=\"snmp\"}[$__rate_interval]))",
          "legendFormat": "disk read",
          "range": true
        }
      ]
    }
  ],
